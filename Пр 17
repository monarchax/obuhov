Задание 1:
def get_days(month):
    month = int(input("Введите номер месяца: "))
    if month == 4 or month == 6 or month == 9 or month == 11:
        return 30
    elif month == 1 or month == 3 or month == 5 or month == 7 or month == 8 or month == 10 or month == 12:
        return 31
    elif month == 2:
        return 28
print(get_days(0))

Задание 2:
def is_prime(num):
    num = int(input("Введите натуральное число: "))
    if num==3:
        return True
    elif num>1 and num%num==0 and num%2!=0 and num%3!=0:
        return True
    else:
        return False
print(is_prime(0))

Задание 3:
def get_next_prime(num):
    num = int(input("Введите натуральное число: "))
    while num>0:
        num += 1
        if num==3:
            return num
        elif num>1 and num%num==0 and num%2!=0 and num%3!=0:
            return num
print(get_next_prime(0))

Задание 4:
def is_password_good(password):
    password = str(input("Введите пароль: "))
    if len(password) < 8:
        print("Длина пароля должна быть не менее 8 символов")
        return False
    elif password.islower() or password.isupper():
        print("Пароль должен содержать как минимум одну заглавную и одну строчную букву")
        return False
    elif password.isalpha() or password.isdigit():
        print("Пароль должен содержать цифру")
        return False
    else:
        return True
print(is_password_good(0))
