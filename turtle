import turtle

# --- Настройки экрана ---
t = turtle.Turtle()
t.speed(0)
t.hideturtle()
screen = turtle.Screen()
screen.bgcolor("lightblue")
screen.setup(width=800, height=700)

GRASS_COLOR = "green"
BLADE_COUNT = 25
BLADE_HEIGHT = 75
START_X = 70
START_Y = 30

# =====================================================
# ПАРА 1 — СОЛНЫШКО
# =====================================================
def sun(x, y):
    RAY_LENGHT = 90
    COUNT_RAY = 16
    WIDTH_SUN = 60
    COLOR_SUN = ("yellow")
    COLOR_RAY = ("orange")
    WIDTH_RAY = 6
    t.color(COLOR_RAY)
    t.width(WIDTH_RAY)
    for i in range(COUNT_RAY):
        t.penup()
        t.goto(300, 250)
        t.pendown()
        t.setheading(i * 22.5)
        t.forward(RAY_LENGHT)
    t.width(1)
    t.penup()
    t.goto(x, y)
    t.pendown()
    t.color(COLOR_SUN)
    t.begin_fill()
    t.circle(WIDTH_SUN)
    t.end_fill()


# =====================================================
# ПАРА 2 — ОБЛАКО
# =====================================================
def cloud(x,y):
    COLOR_CLOUD = ("white")
    t.color(COLOR_CLOUD)
    coords = [
        (100, 280, 40),
        (70, 290, 30),
        (130, 290, 30),
        (50, 270, 25),
        (150, 270, 25),
        (100, 260, 35)]
    for CIRCLE_X, CIRCLE_Y, RADIUS in coords:
        t.penup()
        t.goto(x + CIRCLE_X, y + CIRCLE_Y - RADIUS)
        t.pendown()
        t.begin_fill()
        t.circle(RADIUS)
        t.end_fill()
def grass():
    GRASS_COLOR = "green"
    BLADE_COUNT = 15
    BLADE_HEIGHT = 75
    START_X = 70
    START_Y = 30
    GRASS_COUNT = 40
    t.color(GRASS_COLOR)
    for i in range(GRASS_COUNT):
        t.penup()
        t.goto(-300 + i * BLADE_COUNT, -300)
        t.pendown()
        d = 1 if i % 2 == 0 else -1
        t.setheading(BLADE_HEIGHT + (i % 5) * 10)
        t.width(3 - (i % 2))
        n = START_X + (i % START_Y)
        for j in range(int(n / 10)):
            t.forward(10)
            t.left(5 * d)
        t.width(1)

# =====================================================
# ПАРА 3 — ЦВЕТОК
#  =====================================================

def flower(x, y):
    STEM_COLOR = ("darkgreen")
    STEM_WIDTH = (4)
    STEM_LENGHT = (120)
    PETAL_COUNT = 8
    PETAL_RADIUS = 30
    PETAL_COLOR = ("pink")
    CENTER_RADIUS = 20
    CENTER_COLOR = ("yellow")
    t.color(STEM_COLOR)
    t.width(STEM_WIDTH)
    t.penup()
    t.goto(0, -300)
    t.pendown()
    t.setheading(90)
    t.forward(STEM_LENGHT)
    t.width(1)
    t.color(PETAL_COLOR)
    for i in range(PETAL_COUNT):
        t.penup()
        t.goto(0, -180)
        t.pendown()
        t.setheading(i * 45)
        t.begin_fill()
        t.circle(PETAL_RADIUS, 180)
        t.circle(PETAL_RADIUS, 180)
        t.end_fill()
    t.penup()
    t.goto(x, y)
    t.pendown()
    t.color(CENTER_COLOR)
    t.begin_fill()
    t.circle(CENTER_RADIUS)
    t.end_fill()

# =====================================================
# ПАРА 4 — СЕРДЕЧКО
# =====================================================

def heart(x, y):
    WRITE_MARCH = 36
    WRITE_WOMAN = 20
    WRITE_DAY = 14
    HEART_LENGHT = 62
    HEART_COLOR = ("red")
    t.penup()
    t.goto(x, y)
    t.pendown()
    t.color(HEART_COLOR)
    t.begin_fill()
    t.setheading(140)
    t.forward(HEART_LENGHT)
    t.circle(-35, 200)
    t.setheading(60)
    t.circle(-35, 200)
    t.forward(HEART_LENGHT)
    t.end_fill()

# НАДПИСЬ
def write():
    WRITE_MARCH = 36
    WRITE_WOMAN = 20
    WRITE_DAY = 14
    TEXT_COLOR_MARCH = ("purple")
    TEXT_COLOR_WOMAN = ("deeppink")
    TEXT_COLOR_DAY = ("blue")
    t.penup()
    t.goto(0, 15)
    t.pendown()
    t.color(TEXT_COLOR_MARCH)
    t.write("С 8 Марта!", align="center", font=("Arial", WRITE_MARCH, "bold"))
    t.penup()
    t.goto(0, -7)
    t.pendown()
    t.color(TEXT_COLOR_WOMAN)
    t.write("Дорогие женщины!", align="center", font=("Arial", WRITE_WOMAN, "italic"))
    t.penup()
    t.goto(0, -25)
    t.pendown()
    t.color(TEXT_COLOR_DAY)
    t.write("Пусть каждый день будет ярким!", align="center", font=("Arial", WRITE_DAY, "normal"))

def start():
    sun(278, 195)
    cloud(-150, -100)
    cloud(0, 50)
    cloud(-250, 0)
    grass()
    flower(-15, -195)
    flower(-150, -100)
    flower(0, 50)
    heart(-300, 50)
    heart(300, 50)
    write()
start()

turtle.done()

